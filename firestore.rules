rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid
      );
    }

    function isValidProject() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.files is list
        && data.updatedAt is number;
    }

    function isValidVersion() {
      let data = request.resource.data;
      return data.projectId is string
        && data.timestamp is number
        && data.files is list;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // User accounts cannot be arbitrarily deleted via client
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || resource.data.isPublic == true
      );
      allow create: if isAuthenticated() && isValidProject();
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid && isValidProject();
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Subcollection for project versions
      match /versions/{versionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        ) && isValidVersion();
        allow update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
        );
      }
    }

    // Global version snapshots collection
    match /versions/{versionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated() && isValidVersion();
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Analytics events collection (write-only for telemetry, read by owner)
    match /analytics/{eventId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
