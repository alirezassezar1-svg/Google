# =================================================================
# NONONICK Universal AI Editor – Environment Configuration Template
# =================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# Google Gemini API Key
# Automatically injected in AI Studio. For self-hosted deployment, obtain from: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Hosted Public App URL (Used for OpenAI-compatible gateway, webhooks, and CORS)
APP_URL="https://ais-pre-5ilkxtfwf6yibz3jj2ynl3-17774190120.europe-west3.run.app"

# =================================================================
# Firebase Client SDK Configuration (Optional - falls back to local sandbox)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# =================================================================
VITE_FIREBASE_API_KEY="AIzaSyYourProductionFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
